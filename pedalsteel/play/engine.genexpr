sy = y * env0 * env0 * xs0;                     // the string itself: feeds the sympathetic bus (strings couple at the bridge, before the pickup)
s = (y - yd) * 0.81 * env0 * env0;      // what the pickup hears
xs0 = xs0 + 0.002 * (x0 - xs0); ts0 = ts0 + 0.002 * (t0 - ts0);
tl0 = tl0 + 0.15 * (s - tl0);
s = (tl0 + (s - tl0) * exp2(ts0 * 3 - 1.5)) * xs0;
L = L + s * 0.309;
R = R + s * 0.9511;
lasts0 = sy;
symacc = symacc + sy;


