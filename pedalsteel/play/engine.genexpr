if (wait0 >= 0) {
    wait0 = wait0 - 1;
    if (wait0 < 0) { burst0 = per; vel0 = v0; pol0 = noise() < 0 ? -1 : 1; env0 = swelling ? 0 : 1; plucked = 1; }
}
x = 0;
pkr = clamp(0.000540549 * sr / per, 0.1, 0.5);    // the pick point as a fraction of the sounding string (never past the middle)
pkn = pkr * per;                            // samples of the period spent on the "high" level
pkx = 0;
if (burst0 > 0) {
