x = exlp0;
y = dl0.read(look, interp="cubic");
yd = dl0.read(look + 0.000193053 * sr, interp="cubic");
lp0 = (1 - bb) * y + bb * lp0;
dl0.write(clamp((lp0 + (blk0 > 0 ? 0 : coup0 * 0.008)) * exp(-6.9078 * per / ((blk0 > 0 ? 150 : sustain) * sr / 1000)) + x, -4, 4));
